# Copy to .env and fill in real values.

# PostgreSQL connection string (Neon/Supabase/self-hosted).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign JWTs. REQUIRED in all environments — the app fails to start
# without it. Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="generate-a-long-random-string-at-least-32-chars"

# --- Email (optional but enables verification + password reset) ---
# Resend API key. Enables signup verification + password-reset emails.
# Get a free key at https://resend.com (Settings → API Keys).
# When unset, email signup skips verification (dev convenience).
RESEND_API_KEY=""

# Where business notifications (contact form) are emailed.
CONTACT_NOTIFY_EMAIL="for1s.contact@gmail.com"

# The From address Resend sends as. On Resend's free sandbox use:
#   "FOR1S Contact <onboarding@resend.dev>"
# After verifying your own domain, use e.g. "FOR1S <hello@for1s.com>".
RESEND_FROM="FOR1S Contact <onboarding@resend.dev>"

# --- Social login (OAuth) ---
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client.
# GitHub: github.com/settings/developers → OAuth Apps.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional absolute base URL used in reset/verify email links. When unset,
# the app derives it from the validated request origin (works in dev + prod).
APP_URL=""

# Number of trusted reverse proxies in front of the app. Used to resolve the
# real client IP for rate limiting. 1 (default) = a single nginx/Caddy/Cloudflare
# in front of `next start`. Set to 0 only when the app is exposed directly to
# the internet — proxy headers are then ignored (client-forgeable).
TRUSTED_PROXY_COUNT=1

# Public source repo shown in the footer ("REPO" button). Not a secret.
NEXT_PUBLIC_GITHUB_REPO_URL="https://github.com/subhamrout818/FOR1S"

# --- Seeding ---
# Demo accounts (admin/client) + demo workspace are only created outside
# production (or when SEED_DEMO="1"). Override the demo passwords per env.
SEED_DEMO=""
SEED_ADMIN_PASSWORD=""
SEED_CLIENT_PASSWORD=""

# --- Bot protection: Cloudflare Turnstile (optional, free) ---
# Adds an (almost always invisible) human check to the contact form, signup and
# forgot-password. Create a widget at https://dash.cloudflare.com → Turnstile,
# add your domain (for1s.com), and set BOTH values. If either is empty the
# check is skipped entirely.
# For local testing Cloudflare provides always-pass keys:
#   site key  1x00000000000000000000AA
#   secret    1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Rate limiting ---
# Nothing to configure: counters live in the same Postgres database (table
# "RateLimit", created by the migration — or automatically on first use). If the
# database is slow or down, limits fall back to a per-instance memory counter.
