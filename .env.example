# Copy to .env and fill in real values.

# PostgreSQL connection string (Neon/Supabase/self-hosted).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign JWTs. REQUIRED in production — the app fails to start
# without it. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="generate-a-long-random-string"

# --- Contact-form email notifications (optional) ---
# Resend API key. Enables emailing you when someone submits the contact form.
# Get a free key at https://resend.com (Settings → API Keys).
RESEND_API_KEY=""

# Where those notifications are emailed (defaults to the site's contact email).
CONTACT_NOTIFY_EMAIL="for1s.contact@gmail.com"

# The From address Resend sends as. On Resend's free sandbox use:
#   "FOR1S Contact <onboarding@resend.dev>"
# After verifying your own domain, use e.g. "FOR1S <hello@for1s.digital>".
RESEND_FROM="FOR1S Contact <onboarding@resend.dev>"
