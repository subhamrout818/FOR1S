# Copy to .env and fill in real values.

# PostgreSQL connection string (Neon/Supabase/self-hosted).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign JWTs. REQUIRED in production — the app fails to start
# without it. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="generate-a-long-random-string"
