// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  password          String? // nullable — OAuth users have no password
  profileImage      String?
  provider          String   @default("credentials") // "credentials" | "google" | "github"
  providerAccountId String?
  emailVerified     Boolean  @default(false)
  role              String   @default("client") // "client" | "admin"
  company           String? // client business / company name

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription   Subscription?
  invoices       Invoice[]
  paymentMethods PaymentMethod[]
  projects       Project[] // as the client who owns the project
  comments       Comment[] // comments authored
  files          FileAsset[]
  tickets        SupportTicket[]
  payments       Payment[]
  activities     ActivityEvent[] // events the user triggered

  @@unique([provider, providerAccountId])
}

model Plan {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  tagline     String
  price       Decimal  @db.Decimal(12, 2)
  priceRange  String
  highlighted Boolean  @default(false)
  specs       String[]
  createdAt   DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  planId           String
  status           String    @default("active")
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])
}

model Invoice {
  id          String   @id @default(cuid())
  number      String   @unique
  userId      String
  projectId   String?
  description String
  amount      Decimal  @db.Decimal(12, 2)
  status      String   @default("pending") // "pending" | "paid" | "overdue" | "cancelled"
  dueDate     DateTime?
  issuedAt    DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  payments Payment[]
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  method    String   @default("manual") // "razorpay" | "upi" | "bank" | "manual"
  status    String   @default("completed")
  reference String?
  paidAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  brand     String
  last4     String
  expMonth  Int
  expYear   Int
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  projectType String?
  budget      String?
  message     String
  createdAt   DateTime @default(now())
}

/* ============================================================ */
/*  Client portal — projects, deliverables, files, billing      */
/* ============================================================ */

model Project {
  id            String   @id @default(cuid())
  clientId      String
  name          String
  slug          String   @unique
  tagline       String?
  description   String?
  status        String   @default("active") // "active" | "paused" | "completed"
  progress      Int      @default(0) // 0–100
  value         Decimal? @db.Decimal(12, 2)
  currency      String   @default("INR")
  nextDeadline  DateTime?
  endsAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client       User             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  milestones   Milestone[]
  deliverables Deliverable[]
  folders      Folder[]
  files        FileAsset[]
  invoices     Invoice[]
  activities   ActivityEvent[]

  @@index([clientId])
}

model Milestone {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime
  status      String   @default("upcoming") // "completed" | "in-progress" | "upcoming"
  sortOrder   Int      @default(0)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Deliverable {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  kind        String   @default("reel") // "reel" | "photo" | "design" | "video" | "website" | "document" | "other"
  status      String   @default("draft") // "draft" | "in-review" | "changes-requested" | "approved" | "delivered"
  description String?
  mediaUrl    String?
  posterUrl   String?
  version     Int      @default(1)
  dueAt       DateTime?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions DeliverableVersion[]
  comments Comment[]

  @@index([projectId])
}

model DeliverableVersion {
  id            String   @id @default(cuid())
  deliverableId String
  version       Int
  status        String   @default("in-review") // mirrors Deliverable.status at upload time
  note          String?
  mediaUrl      String?
  posterUrl     String?
  createdAt     DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId])
}

model Comment {
  id            String   @id @default(cuid())
  deliverableId String
  authorId      String
  body          String
  createdAt     DateTime @default(now())

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([deliverableId])
}

model Folder {
  id        String   @id @default(cuid())
  projectId String
  name      String
  kind      String   @default("general") // "brand" | "raw" | "final" | "documents" | "general"
  createdAt DateTime @default(now())

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files   FileAsset[]

  @@index([projectId])
}

model FileAsset {
  id           String   @id @default(cuid())
  projectId    String
  folderId     String?
  name         String
  url          String
  mimeType     String?
  size         Int?
  kind         String   @default("asset")
  uploadedById String
  createdAt    DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploader User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  budget    String?
  service   String?
  source    String? // "contact-form" | "referral" | "instagram" | "website"
  status    String   @default("new") // "new" | "contacted" | "qualified" | "won" | "lost"
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  message   String
  status    String   @default("open") // "open" | "replied" | "closed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityEvent {
  id        String   @id @default(cuid())
  projectId String?
  actorId   String?
  type      String // "approval" | "upload" | "payment" | "comment" | "delivery" | "system"
  title     String
  detail    String?
  createdAt DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([createdAt])
}

